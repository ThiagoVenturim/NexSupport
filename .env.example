# Database connection URL (SQLAlchemy format).
# Defaults to local SQLite at support_engine.db (or /data/support_engine.db in container) when unset.
DB_URL=sqlite:///support_engine.db

# Examples for external databases:
# DB_URL=postgresql+psycopg://support:changeme@localhost:5432/support_engine
# DB_URL=mysql+pymysql://support:changeme@localhost:3306/support_engine
# DB_URL=mssql+pyodbc://support:changeme@localhost:1433/support_engine?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Access token of the copilot REST API and MCP over HTTP (at least 16 characters).
# Generate a random value, for example: python -c "import secrets; print(secrets.token_urlsafe(32))"
SUPPORT_ENGINE_API_TOKEN=

# NexLink: one token and one scope list per project that calls the Support Engine.
# Scopes: ingest:run, copilot:suggest, metrics:read. Leave the tokens empty to disable a client.
SUPPORT_ENGINE_NEXLINK_CLIENT_NEXHUB_TOKEN=
SUPPORT_ENGINE_NEXLINK_CLIENT_NEXHUB_SCOPES=ingest:run,metrics:read
SUPPORT_ENGINE_NEXLINK_CLIENT_NEXCODER_TOKEN=
SUPPORT_ENGINE_NEXLINK_CLIENT_NEXCODER_SCOPES=metrics:read

# askdash (NexDash) report engine used by support_engine.metrics.NexDashClient and by NexLink.
# The token is the NexDash client token of NexSupport (its NEXDASH_CLIENT_NEXSUPPORT_TOKEN,
# scopes reports:list,reports:run).
NEXDASH_URL=http://127.0.0.1:8000
NEXDASH_ENGINE_TOKEN=

# Help desk integrations over OAuth 2.0 (support-engine oauth-login <provider>, then sync <provider>).
# Register an OAuth app on each platform with read-only access to tickets and set its redirect URI
# (https, or http://127.0.0.1:<port>/callback for a CLI login). The login writes the ACCESS_TOKEN,
# REFRESH_TOKEN, EXPIRES_AT and GRANTED_SCOPES of each provider into this .env file; never commit it.
SUPPORT_ENGINE_OAUTH_ZENDESK_SUBDOMAIN=
SUPPORT_ENGINE_OAUTH_ZENDESK_CLIENT_ID=
SUPPORT_ENGINE_OAUTH_ZENDESK_CLIENT_SECRET=
SUPPORT_ENGINE_OAUTH_ZENDESK_REDIRECT_URI=http://127.0.0.1:8765/callback
SUPPORT_ENGINE_OAUTH_INTERCOM_CLIENT_ID=
SUPPORT_ENGINE_OAUTH_INTERCOM_CLIENT_SECRET=
SUPPORT_ENGINE_OAUTH_INTERCOM_REDIRECT_URI=http://127.0.0.1:8765/callback
SUPPORT_ENGINE_OAUTH_JIRA_SM_CLOUD_ID=
SUPPORT_ENGINE_OAUTH_JIRA_SM_CLIENT_ID=
SUPPORT_ENGINE_OAUTH_JIRA_SM_CLIENT_SECRET=
SUPPORT_ENGINE_OAUTH_JIRA_SM_REDIRECT_URI=http://127.0.0.1:8765/callback
# Freshdesk: only when the account issues OAuth tokens through a Freshworks app (otherwise use an API key).
SUPPORT_ENGINE_OAUTH_FRESHDESK_DOMAIN=
SUPPORT_ENGINE_OAUTH_FRESHDESK_AUTHORIZE_URL=
SUPPORT_ENGINE_OAUTH_FRESHDESK_TOKEN_URL=
SUPPORT_ENGINE_OAUTH_FRESHDESK_SCOPES=
SUPPORT_ENGINE_OAUTH_FRESHDESK_CLIENT_ID=
SUPPORT_ENGINE_OAUTH_FRESHDESK_CLIENT_SECRET=
SUPPORT_ENGINE_OAUTH_FRESHDESK_REDIRECT_URI=http://127.0.0.1:8765/callback

# Optional PostgreSQL configuration (used with docker compose --profile postgres)
POSTGRES_USER=support
POSTGRES_PASSWORD=changeme
POSTGRES_DB=support_engine
POSTGRES_PORT=5432
